# Copy to .env and fill in. Never commit .env.
#
# The only secret this project requires. Get one at https://openrouter.ai/keys.
# Retrieval (ingest, indexing, BM25/dense/hybrid eval) needs no key at all --
# it is only the generation stage that calls out.
OPENROUTER_API_KEY=

# Optional. Base URL of a local Ollama server, used as the offline fallback and
# by the three local arms the published answer table actually ran on.
# OLLAMA_HOST=http://localhost:11434

# --- the deployed demo (space/app.py) reads these; the CLI does not -----------
#
# Which generation arm the demo uses. `ollama-qwen` needs no key at all, which
# is the point: a deployment sitting beside its own Ollama does not have to
# fork the app to say so. See `MODEL_ARMS` in src/production_rag/providers.py.
# MODEL_ARM=nemotron-super
#
# Where the baked index lives inside the container image. Unset, the demo pulls
# the pinned dataset from the Hub instead.
# INDEX_DIR=/opt/index
# INDEX_REPO=Prithv122/production-rag-index
# CACHE_DIR=/tmp/production-rag
#
# LOG_LEVEL=INFO
