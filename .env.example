# Copy to .env and fill in. Never commit .env.
#
# The only secret this project requires. Get one at https://openrouter.ai/keys.
# Retrieval (ingest, indexing, BM25/dense/hybrid eval) needs no key at all --
# it is only the generation stage that calls out.
OPENROUTER_API_KEY=

# Optional. Overrides the default generation model (see README section 4).
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional. Base URL of a local Ollama server used as the offline fallback.
# OLLAMA_HOST=http://localhost:11434
