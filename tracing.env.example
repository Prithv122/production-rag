# Copy to tracing.env (untracked) and replace every REPLACE_ME value. Never commit tracing.env.
#
#   docker compose --env-file tracing.env -f tracing.compose.yml up -d --wait
#
# Generate each random value yourself, for example:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
# ENCRYPTION_KEY must be exactly 64 hex characters. Nothing below is a real credential.

# --- the local Langfuse stack ---------------------------------------------------
POSTGRES_PASSWORD=REPLACE_ME
CLICKHOUSE_PASSWORD=REPLACE_ME
REDIS_AUTH=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_ME
NEXTAUTH_SECRET=REPLACE_ME
SALT=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME

# Headless first-run setup: an organisation, a project, the project's API keys and a user.
# Langfuse API keys are pk-lf-... / sk-lf-...; choose your own values here.
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=local
LANGFUSE_INIT_PROJECT_ID=production-rag
LANGFUSE_INIT_PROJECT_NAME=production-rag
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_INIT_USER_EMAIL=you@example.invalid
LANGFUSE_INIT_USER_NAME=local
LANGFUSE_INIT_USER_PASSWORD=REPLACE_ME

# --- the app / trace-bench side (set these in the shell that runs the app) ------
# Not read by the compose file. Shown here so the names sit next to the keys they use.
#
# Langfuse accepts OTLP over HTTP at /api/public/otel with Basic auth, where the
# credential is base64("<public key>:<secret key>"). PowerShell:
#   $b64 = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("pk-lf-...:sk-lf-..."))
#   $env:OTEL_EXPORTER_OTLP_ENDPOINT = "http://127.0.0.1:3000/api/public/otel"
#   $env:OTEL_EXPORTER_OTLP_HEADERS = "Authorization=Basic $b64"
#
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:3000/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic REPLACE_WITH_BASE64_OF_PUBLIC_COLON_SECRET
#
# Langfuse Cloud and the v4 line additionally want the header
#   x-langfuse-ingestion-version=4
# (comma-separated in OTEL_EXPORTER_OTLP_HEADERS) for real-time ingestion.
#
# Arize Phoenix instead (no auth locally):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006
#
# Privacy switch: leave unset to export timings, tokens and models but no question text.
# PRODUCTION_RAG_TRACE_CONTENT=1
